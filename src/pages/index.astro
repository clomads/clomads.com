---
// Landing page: src/content/home.md. The card grid (`featured`: page paths) comes first, then the body text.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import { years } from '../routeData';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = (await getEntry('home', 'home'))!;
const { Content } = await render(home);
const LABEL: Record<string, string> = { concept: 'Concept', prototype: 'Prototype', ongoing: 'Ongoing', shelved: 'Shelved' };
const cards = (await Promise.all(home.data.featured.map((id) => getEntry('docs', id))))
  .filter((p) => p && !(import.meta.env.PROD && p.data.draft))
  .map((p) => ({ id: p!.id, ...p!.data, tag: [years(p!.data), LABEL[p!.data.status ?? '']].filter(Boolean).join(' · ') }));
---
<StarlightPage frontmatter={{ title: home.data.title, description: home.data.description, tableOfContents: false, pagefind: false }}>
  <div class="landing not-content">
    {cards.length > 0 && (
      <section class="cards">
        {cards.map((w) => (
          <article class="card">
            <a class="hero" href={`${base}/${w.id}/`} aria-label={w.title}>
              {w.cover ? <Image src={w.cover} alt="" width={800} loading="eager" /> : <span class="hero-empty">{w.title}</span>}
              {w.tag && <span class="tag">{w.tag}</span>}
            </a>
            <h2><a href={`${base}/${w.id}/`}>{w.title}</a></h2>
            <p>{w.description}</p>
          </article>
        ))}
      </section>
    )}
    <section class="copy"><Content /></section>
  </div>
</StarlightPage>

<style>
  .landing { display: flex; flex-direction: column; gap: 2.5rem; margin-top: 2rem; }
  .landing > * { margin: 0; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem 1.5rem; }
  .card .hero { position: relative; display: block; aspect-ratio: 4 / 3; border-radius: 16px; overflow: hidden; background: var(--luna-tint); }
  .card .hero img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease; }
  .card .hero:hover img { transform: scale(1.03); }
  .card .hero-empty { display: grid; place-items: center; height: 100%; padding: 1rem; text-align: center; font-family: var(--luna-display); font-size: 1.75rem; color: var(--sl-color-black); }
  .card .tag { position: absolute; left: 0.75rem; bottom: 0.7rem; font-family: var(--sl-font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; color: #fff; background: rgb(0 0 0 / 0.65); padding: 0.25rem 0.5rem; border-radius: 6px; }
  .card h2 { font-family: var(--luna-display); font-weight: 400; font-size: 1.6rem; line-height: 1.05; margin: 0.9rem 0 0.35rem; }
  .card h2 a { color: var(--sl-color-white); text-decoration: none; }
  .card h2 a:hover { color: var(--sl-color-accent); }
  .card p { color: var(--sl-color-gray-2); margin: 0; }
  @media (max-width: 72rem) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 40rem) { .cards { grid-template-columns: 1fr; } }
  /* Prose from the Home note */
  .copy { max-width: 62ch; }
  .copy :global(h2) { font-family: var(--luna-display); font-weight: 400; font-size: 2rem; line-height: 1.05; margin: 2.5rem 0 0.6rem; }
  .copy :global(h2:first-child) { margin-top: 0; }
  .copy :global(p), .copy :global(li) { color: var(--sl-color-gray-2); }
  .copy :global(p + p), .copy :global(ul + p), .copy :global(p + ul) { margin-top: 0.75rem; }
  .copy :global(ul) { padding-left: 1.2rem; }
  .copy :global(a) { color: var(--sl-color-accent); }
  .copy :global(strong) { color: var(--sl-color-white); font-weight: 600; }
  .copy :global(del) { color: var(--sl-color-gray-4); }
</style>
